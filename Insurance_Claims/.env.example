# Local agent + local records. Gemini still requires network access and a key.
AGENT_BACKEND=local
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-google-ai-studio-api-key
CLAIMS_STORE=local
# CLAIMS_DATA_DIR=.local/data

# For a deployed agent: local portals use ADC, the agent uses its service account.
# AGENT_BACKEND=vertex
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1
# AGENT_ENGINE_ID=projects/your-project/locations/us-central1/reasoningEngines/your-id
# CLAIMS_STORE=firestore
# CLAIMS_FIRESTORE_DATABASE=(default)
# CLAIMS_EVIDENCE_BUCKET=your-private-evidence-bucket
# CLAIMS_EVIDENCE_PREFIX=

# Optional alternate environment file, set in your shell before launching:
# CLAIMS_ENV_FILE=/absolute/path/to/development.env
